# Frontend (Vite) environment. Copy to ".env" and adjust.
# Only VITE_-prefixed vars are exposed to the client bundle.

# Backend origin (scheme + host + port), no trailing slash.
VITE_API_ORIGIN=http://localhost:5286

# Optional explicit overrides (derived from VITE_API_ORIGIN if omitted):
# VITE_API_BASE_URL=http://localhost:5286/api/v1
# VITE_CHAT_HUB_URL=http://localhost:5286/hubs/chat
# VITE_NOTIFICATION_HUB_URL=http://localhost:5286/hubs/notification
