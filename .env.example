# ============================================================
# Facebook Clone - Environment Configuration (EXAMPLE)
# Copy this file to ".env" and adjust values for your machine.
#   cp .env.example .env
# The backend loads this file automatically on startup (DotNetEnv,
# path traversal), so ".env" can live at the repo root.
# NOTE: ".env" is gitignored - never commit real secrets.
# ============================================================

# --- Database (PostgreSQL) ---
# ASP.NET Core reads "Section__Key" env vars into IConfiguration.
# This overrides ConnectionStrings:Default in appsettings.json.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=facebook_clone;Username=fb_admin;Password=fb_password

# Individual pieces (used by docker-compose for the postgres container)
POSTGRES_DB=facebook_clone
POSTGRES_USER=fb_admin
POSTGRES_PASSWORD=fb_password
POSTGRES_PORT=5432

# --- Database bootstrap behavior (backend startup) ---
# AutoMigrate: create the database if missing + apply EF Core migrations.
# AutoSeed:    insert demo/seed data when tables are empty.
Database__AutoMigrate=true
Database__AutoSeed=true

# --- JWT ---
Jwt__Secret=THIS_IS_A_SUPER_SECRET_KEY_CHANGE_LATER
Jwt__Issuer=FacebookClone
Jwt__Audience=FacebookCloneClient
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7
