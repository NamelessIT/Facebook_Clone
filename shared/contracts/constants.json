{
  "version": "1.0.0",
  "description": "Shared non-enum constants (frontend-facing). Edit here, then run scripts/generate_shared_contracts.py",
  "api": {
    "prefix": "/api/v1"
  },
  "hubs": {
    "chat": "/hubs/chat",
    "notification": "/hubs/notification"
  },
  "storageKeys": {
    "accessToken": "accessToken",
    "refreshToken": "refreshToken",
    "themeMode": "app_theme_mode",
    "locale": "app_locale"
  },
  "limits": {
    "feedPageSize": 10,
    "commentsPageSize": 20,
    "savedItemsPageSize": 10,
    "notificationPageSize": 10,
    "friendshipPageSize": 20,
    "searchDebounceMs": 300,
    "messageMaxLength": 1000,
    "editPostMaxContentLength": 500,
    "profileBioMaxLength": 200,
    "postPreviewTextLimit": 120,
    "maxImageUploadMb": 10,
    "maxVideoUploadMb": 100
  },
  "timers": {
    "presenceHeartbeatMs": 900000,
    "adminUsersRefreshMs": 300000,
    "userOnlineTtlMinutes": 16,
    "chatTypingDebounceMs": 300,
    "chatTypingTimeoutMs": 3000,
    "postDeleteUndoSeconds": 10,
    "notInterestedAutoDismissSeconds": 60
  },
  "localization": {
    "defaultLocale": "vi",
    "fallbackLocale": "en",
    "maxTranslationChunkChars": 800
  }
}
