{
  "version": "1.0.0",
  "description": "Shared non-enum constants (frontend-facing). Edit here, then run scripts/generate_shared_contracts.py",
  "api": {
    "prefix": "/api/v1"
  },
  "hubs": {
    "chat": "/hubs/chat",
    "notification": "/hubs/notification"
  },
  "storageKeys": {
    "accessToken": "accessToken",
    "refreshToken": "refreshToken",
    "themeMode": "app_theme_mode",
    "locale": "app_locale"
  },
  "limits": {
    "feedPageSize": 10,
    "commentsPageSize": 20,
    "savedItemsPageSize": 10,
    "notificationPageSize": 10,
    "friendshipPageSize": 20,
    "searchDebounceMs": 300,
    "messageMaxLength": 1000,
    "editPostMaxContentLength": 500,
    "profileBioMaxLength": 200,
    "postPreviewTextLimit": 120,
    "passwordMinLength": 8,
    "adminRoleMinLevel": 50,
    "maxRoleLevel": 100,
    "maxImageUploadMb": 10,
    "maxVideoUploadMb": 100
  },
  "timers": {
    "presenceHeartbeatMs": 900000,
    "adminUsersRefreshMs": 300000,
    "userOnlineTtlMinutes": 16,
    "chatTypingDebounceMs": 300,
    "chatTypingTimeoutMs": 3000,
    "postDeleteUndoSeconds": 10,
    "notInterestedAutoDismissSeconds": 60
  },
  "localization": {
    "defaultLocale": "vi",
    "fallbackLocale": "en",
    "maxTranslationChunkChars": 800
  },
  "security": {
    "telemetryRetentionMinutes": 1440,
    "maxTrackedIps": 5000,
    "maxSamplesPerIp": 1000,
    "suspiciousRequestRatePerMinute": 60,
    "highRequestRatePerMinute": 120,
    "mediumRiskScore": 35,
    "highRiskScore": 70,
    "criticalRiskScore": 90,
    "defaultInvestigationBlockHours": 24
  },
  "offline": {
    "dbName": "fbclone_offline",
    "dbVersion": 1,
    "maxActions": 1000,
    "maxAgeDays": 30,
    "syncBatchSize": 25,
    "retryBackoffMs": [1000, 5000, 15000, 60000, 300000],
    "actionStatuses": ["pending", "syncing", "completed", "failed", "rolled_back", "expired", "paused", "conflict"],
    "retryableStatuses": ["pending", "failed", "paused"],
    "terminalStatuses": ["completed", "rolled_back", "expired"],
    "actionTypes": [
      "post.create",
      "post.update",
      "post.delete",
      "post.share",
      "comment.create",
      "comment.delete",
      "reaction.set",
      "reaction.remove",
      "saved.add",
      "saved.remove",
      "friendship.send",
      "friendship.accept",
      "friendship.reject",
      "friendship.remove",
      "chat.send",
      "reel.create",
      "reel.update",
      "reel.delete",
      "profile.update"
    ]
  },
  "uploadChunks": {
    "maxRecords": 2000,
    "maxAgeDays": 30,
    "defaultChunkSizeBytes": 5242880,
    "maxChunkSizeBytes": 10485760,
    "targetTypes": ["post", "reel"],
    "statuses": ["pending", "uploading", "completed", "failed", "paused", "expired"]
  }
}
